 # FlowForge AI Environment Configuration Example
# Copy this file to .env and configure as needed.

# Application Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Optional LLM / AI Integration Keys (Not required for standard heuristics/GA scheduling)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Optional API Base URL (leave empty for same-origin relative URLs)
API_BASE_URL=
